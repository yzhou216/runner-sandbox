From 4e14d3c8cf1e14c5abb55edef1dfb98270b3c243 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Thu, 26 Nov 2026 13:24:31 -0800
Subject: [PATCH] linuxPackages.xnulinux: init at 0-unstable-2026-11-27

---
 pkgs/os-specific/linux/xnulinux/default.nix | 75 +++++++++++++++++++++
 pkgs/top-level/linux-kernels.nix            |  2 +
 2 files changed, 77 insertions(+)
 create mode 100644 pkgs/os-specific/linux/xnulinux/default.nix

diff --git a/pkgs/os-specific/linux/xnulinux/default.nix b/pkgs/os-specific/linux/xnulinux/default.nix
new file mode 100644
index 000000000000..641235c36651
--- /dev/null
+++ b/pkgs/os-specific/linux/xnulinux/default.nix
@@ -0,0 +1,75 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  kernel,
+  kernelModuleMakeFlags,
+  unstableGitUpdater,
+}:
+
+stdenv.mkDerivation {
+  pname = "xnulinux";
+  version = "0-unstable-2026-11-27";
+
+  src = fetchFromGitHub {
+    owner = "AFK-surf";
+    repo = "xnulinux";
+    rev = "803cfe0b7dad434e6eeb98d254b2c14cadc991d8";
+    hash = "sha256-45QRA9u9G+dPrKLf8Be6KV8Dy9ZMsZz0Y/RH6UOEOYg=";
+  };
+
+  __structuredAttrs = true;
+  strictDeps = true;
+
+  nativeBuildInputs = kernel.moduleBuildDependencies;
+
+  makeFlags = kernelModuleMakeFlags ++ [
+    "-C"
+    "${kernel.dev}/lib/modules/${kernel.modDirVersion}/build"
+    "INSTALL_MOD_PATH=${placeholder "out"}"
+  ];
+
+  # xnu.ko links against the symbols fki.ko exports
+  buildPhase = ''
+    runHook preBuild
+
+    make "''${makeFlags[@]}" M="$PWD/fki-ko" modules
+    make "''${makeFlags[@]}" M="$PWD/xnu-ko" KBUILD_EXTRA_SYMBOLS="$PWD/fki-ko/Module.symvers" modules
+
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+
+    make "''${makeFlags[@]}" M="$PWD/fki-ko" modules_install
+    make "''${makeFlags[@]}" M="$PWD/xnu-ko" modules_install
+
+    runHook postInstall
+  '';
+
+  passthru.updateScript = unstableGitUpdater { };
+
+  meta = {
+    description = "Kernel modules that run XNU, the macOS kernel, inside arm64 Linux";
+    longDescription = ''
+      xnulinux runs a source-built XNU kernel collection as a Linux kernel
+      module, so that Darwin userspace runs natively next to Linux processes.
+      fki.ko lends XNU the host's CPUs, memory, files and network, and xnu.ko
+      loads the kernel collection from the firmware search path and runs it.
+      The kernel collection and the system disk are built separately, as the
+      upstream documentation describes.
+    '';
+    homepage = "https://github.com/AFK-surf/xnulinux";
+    license = with lib.licenses; [
+      gpl2Only # fki.ko
+      apple-psl20 # xnu.ko
+    ];
+    maintainers = with lib.maintainers; [ yiyu ];
+    platforms = [ "aarch64-linux" ];
+    # Upstream asks that the non-GPL xnu.ko be built on the host, not shipped prebuilt
+    hydraPlatforms = [ ];
+    # kernel_neon_begin takes a buffer since 6.19
+    broken = kernel.kernelOlder "6.19";
+  };
+}
diff --git a/pkgs/top-level/linux-kernels.nix b/pkgs/top-level/linux-kernels.nix
index d93b3ee61e3c..ad2f152b1992 100644
--- a/pkgs/top-level/linux-kernels.nix
+++ b/pkgs/top-level/linux-kernels.nix
@@ -550,6 +550,8 @@ in
 
         x86_energy_perf_policy = callPackage ../os-specific/linux/x86_energy_perf_policy { };
 
+        xnulinux = callPackage ../os-specific/linux/xnulinux { };
+
         xone =
           if lib.versionAtLeast kernel.version "5.4" then callPackage ../os-specific/linux/xone { } else null;
 
-- 
