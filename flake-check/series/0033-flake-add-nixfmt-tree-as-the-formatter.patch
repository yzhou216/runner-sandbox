From 1b1b92f5d3bbb504cff31ebae7e5e10b5f3c2617 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Sat, 28 Nov 2026 02:42:19 -0800
Subject: [PATCH 33/47] flake: add nixfmt-tree as the formatter

Expose nixfmt-tree, the treefmt wrapper around nixfmt that nixpkgs
provides for this purpose, as the formatter for both platforms of the
flake, so that `nix fmt` formats every Nix file of the repository
with the nixfmt of the pinned nixpkgs.  Calling nixfmt on a directory
is deprecated, and the wrapper walks the tree itself.
---
 flake.nix | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/flake.nix b/flake.nix
index 76ebb34..181c416 100644
--- a/flake.nix
+++ b/flake.nix
@@ -196,5 +196,11 @@
         iris = mkDarwin "iris";
         lexi = mkDarwin "lexi";
       };
+
+      # nix fmt
+      formatter = nixpkgs.lib.genAttrs [
+        "x86_64-linux"
+        "aarch64-darwin"
+      ] (system: nixpkgs.legacyPackages.${system}.nixfmt-tree);
     };
 }
