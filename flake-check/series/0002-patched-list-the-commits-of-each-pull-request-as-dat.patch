From 9690b0b557c55106fcb203120704c65f5577c472 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Sat, 28 Nov 2026 02:41:21 -0800
Subject: [PATCH 02/47] patched: list the commits of each pull request as data

fetchPrCommit has taken the number of the pull request without using it
since a218e78 ("flake: fetch nixpkgs patches from commit URLs"), and
deadnix reports it.  List each pull request with its URL and its
commits instead, and take the repository of the commit URLs from the
URL of the pull request, so that each pull request is written once and
used.

Each commit is an attribute set of its revision and the hash of its
patch, and passes any other attribute on to fetchpatch, so that a patch
that needs `includes` fits the same list.  applyPullRequests takes the
name and the source tree, so that another input, such as disko, can be
patched with one more call next to nixpkgs-patched.  fetchpatch and
applyPatches get the same arguments as before, so every derivation
stays the same.
---
 patched.nix | 143 +++++++++++++++++++++++++++++++++-------------------
 1 file changed, 92 insertions(+), 51 deletions(-)

diff --git a/patched.nix b/patched.nix
index 0a9d2fa..9277533 100644
--- a/patched.nix
+++ b/patched.nix
@@ -1,59 +1,100 @@
+/*
+  Flake inputs with commits from open pull requests applied on top.
+  Each commit is pinned so that pushes to a pull request do not
+  invalidate the hashes.
+
+  TODO: remove each pull request once it is merged, and this file once
+  none are left.
+*/
 { nixpkgs, ... }:
+let
+  inherit (nixpkgs) lib;
+  pkgs = nixpkgs.legacyPackages.x86_64-linux;
+
+  /*
+    Fetch the patch of a commit of the GitHub pull request `pr` from
+    the commit URL in the repository of the pull request.  Attributes
+    of the commit other than `rev` are passed on to fetchpatch.
+  */
+  fetchPrCommit =
+    pr:
+    { rev, ... }@commit:
+    let
+      repo = lib.head (lib.splitString "/pull/" pr.url);
+    in
+    pkgs.fetchpatch ({ url = "${repo}/commit/${rev}.patch"; } // removeAttrs commit [ "rev" ]);
+
+  /*
+    Apply the commits of `pullRequests` on top of the source tree `src`.
+    Each pull request has its URL and its commits in the order they
+    apply, each with its revision and the hash of its patch.
+  */
+  applyPullRequests =
+    {
+      name,
+      src,
+      pullRequests,
+    }:
+    pkgs.applyPatches {
+      inherit name src;
+      patches = lib.concatMap (pr: map (fetchPrCommit pr) pr.commits) pullRequests;
+    };
+in
