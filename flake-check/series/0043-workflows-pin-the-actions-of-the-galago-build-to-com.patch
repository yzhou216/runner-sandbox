From 408c59b606db28f3d68a7631b7c2244bfdb57ad1 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Sat, 28 Nov 2026 02:49:26 -0800
Subject: [PATCH 43/47] workflows: pin the actions of the galago build to
 commits

The build ran the default branch of actions/checkout, nothing-but-nix,
and cachix-action, in a job that holds CACHIX_AUTH_TOKEN, and
nothing-but-nix runs as root before the token is used.  A push to any
of those branches could thus push paths into the cache that the
machines trust.  Pin each to the commit of its latest release instead,
as the other actions of both workflows are, and name the release in a
comment.
---
 .github/workflows/build-galago.yml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/build-galago.yml b/.github/workflows/build-galago.yml
index fdfb073..5610ef2 100644
--- a/.github/workflows/build-galago.yml
+++ b/.github/workflows/build-galago.yml
@@ -42,15 +42,15 @@ jobs:
     runs-on: ubuntu-latest
     timeout-minutes: 360
     steps:
-      - uses: actions/checkout@main
-      - uses: wimpysworld/nothing-but-nix@main
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: wimpysworld/nothing-but-nix@b2574ec1cf1462bee0a34de0fb6ff11ad3c43cb2 # v12
       - uses: cachix/install-nix-action@382a9ed9481c7c1f94f68b72ef105b3417c73877 # v32.1.0
         with:
           extra_nix_config: |
             # Substitute from the caches that the nixConfig of flake.nix names
             accept-flake-config = true
             build-dir = /nix/build
-      - uses: cachix/cachix-action@master
+      - uses: cachix/cachix-action@38b082610b782e7e93e209c35fd730d399dee866 # v17
         with:
           name: yzhou216
           authToken: ${{ secrets.CACHIX_AUTH_TOKEN }}
-- 
