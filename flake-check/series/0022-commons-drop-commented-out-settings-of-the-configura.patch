From e8a59bb96549a05ff60a101b32ef2ab9e92ed5b6 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Sat, 28 Nov 2026 02:40:57 -0800
Subject: [PATCH 22/47] commons: drop commented-out settings of the
 configuration.nix template

The commented-out firewall ports, network proxy, and mtr come from the
configuration.nix that nixos-generate-config writes, and none of them
was ever set.  Drop them.
---
 systems/nixos/commons.nix | 13 -------------
 1 file changed, 13 deletions(-)

diff --git a/systems/nixos/commons.nix b/systems/nixos/commons.nix
index 7442ea8..f6a3427 100644
--- a/systems/nixos/commons.nix
+++ b/systems/nixos/commons.nix
@@ -38,14 +38,7 @@
     firewall = {
       enable = true;
       package = pkgs.nftables;
-      # Open ports in the firewall
-      #allowedTCPPorts = [ ... ];
-      #allowedUDPPorts = [ ... ];
     };
-
-    # Network proxy
-    #proxy.default = "http://user:password@proxy:port/";
-    #proxy.noProxy = "127.0.0.1,localhost,internal.domain";
   };
 
   # Internationalisation properties.
@@ -252,11 +245,5 @@
     };
 
     nix-index.enable = true;
-
-    /*
-      Some programs need SUID wrappers, can be configured further or
-      are started in user sessions.
-    */
-    #mtr.enable = true;
   };
 }
-- 
2.56.1

