From e385f5d0a08f9fcaeaa5e53f89a60211207057d9 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Sat, 28 Nov 2026 02:36:17 -0800
Subject: [PATCH 2/3] commons: pin emacs master as a flake input

builtins.fetchGit with a ref and no rev resolved the master branch of
Emacs at evaluation time, which is impure, and cloned its whole history
to do so.  As a non-flake input, the commit is locked in flake.lock and
moves with `nix flake update`, and the github fetcher downloads a
single tarball of it.

Emacs sets no export-ignore, export-subst, text, or eol attributes in
.gitattributes, so the tarball that GitHub serves holds the same tree
as the checkout, and the source of emacs-git keeps its store path.
---
 flake.lock                | 18 ++++++++++++++++++
 flake.nix                 |  6 ++++++
 systems/nixos/commons.nix |  5 +----
 3 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/flake.lock b/flake.lock
index e7406a1..fd25cb0 100644
--- a/flake.lock
+++ b/flake.lock
@@ -100,6 +100,23 @@
         "type": "github"
       }
     },
+    "emacs-src": {
+      "flake": false,
+      "locked": {
+        "lastModified": 1795861319,
+        "narHash": "sha256-zOw0pJALCp5cG08LvxIDqgYrsZT3deF2Ty/PkNLAXJs=",
+        "owner": "emacsmirror",
+        "repo": "emacs",
+        "rev": "f55a12f0b7976772b1744dc8c0150e5c013f40b2",
+        "type": "github"
+      },
+      "original": {
+        "owner": "emacsmirror",
+        "ref": "master",
+        "repo": "emacs",
+        "type": "github"
+      }
+    },
     "flake-compat": {
       "flake": false,
       "locked": {
@@ -447,6 +464,7 @@
         "darwin": "darwin",
         "disko": "disko",
         "emacs-overlay": "emacs-overlay",
+        "emacs-src": "emacs-src",
         "homebrew-bundle": "homebrew-bundle",
         "homebrew-cask": "homebrew-cask",
         "homebrew-core": "homebrew-core",
diff --git a/flake.nix b/flake.nix
index 6bee0bd..76a78a5 100644
--- a/flake.nix
+++ b/flake.nix
@@ -34,6 +34,12 @@
       inputs.nixpkgs.follows = "nixpkgs";
     };
 
+    # Emacs master, built as emacs-git by systems/nixos/commons.nix
+    emacs-src = {
+      url = "github:emacsmirror/emacs?ref=master";
+      flake = false;
+    };
+
     darwin = {
       url = "github:lnl7/nix-darwin";
       inputs.nixpkgs.follows = "nixpkgs";
diff --git a/systems/nixos/commons.nix b/systems/nixos/commons.nix
index 3d9f5e7..113b600 100644
--- a/systems/nixos/commons.nix
+++ b/systems/nixos/commons.nix
@@ -76,10 +76,7 @@
     (final: prev: {
       emacs-git = prev.emacs-git.overrideAttrs (
         _: prevAttrs: {
-          src = builtins.fetchGit {
-            url = "https://github.com/emacsmirror/emacs.git";
-            ref = "master";
-          };
+          src = inputs.emacs-src;
 
           # Keep RET from being refilled away by `refill-mode' in Org
           patches = (prevAttrs.patches or [ ]) ++ [ ./emacs-refill-newline.patch ];
-- 
