+# Builds galago and pushes each path it builds to the yzhou216 Cachix
+# cache.
+#
+# On a push to master, it builds the inputs that flake.lock pins, which
+# is what `nixos-rebuild switch --flake . --impure` deploys, so a
+# failure there means that the committed configuration does not build.
+# Only the Emacs overlay and emacs-git, which systems/nixos/commons.nix
+# fetches unpinned, are not pinned.
+#
+# Once a day, and when dispatched with `update`, it runs
+# `nix flake update` first, to find out whether galago builds with the
+# latest inputs and to fill the cache before the next update.  A
+# failure there is breakage upstream that updating would bring in.  The
+# job summary lists the inputs that changed, and the run keeps the
+# updated flake.lock as an artifact; to commit the inputs that the run
+# built, fetch it with
+# `gh run download <run> -R yzhou216/flake -n flake.lock`.
+name: build galago
 on:
+  push:
+    branches: [master]
   schedule:
-    - cron: "0 */1 * * *"
+    - cron: "17 3 * * *"
   workflow_dispatch:
-
+    inputs:
+      update:
+        description: Update the flake inputs before building
+        type: boolean
+        default: true
+# Newer run of the same kind cancels the one in progress
+concurrency:
+  group: ${{ github.workflow }}-${{ (github.event_name == 'schedule' || inputs.update) && 'update' || 'locked' }}
+  cancel-in-progress: true
+permissions:
+  contents: read
+# Explicit shell adds -o pipefail, which `nix flake update | tee` needs
+defaults:
+  run:
+    shell: bash
+env:
+  UPDATE: ${{ github.event_name == 'schedule' || inputs.update }}
 jobs:
   build:
     runs-on: ubuntu-latest
+    timeout-minutes: 360
     steps:
-      - uses: actions/checkout@main
-      - uses: wimpysworld/nothing-but-nix@main
-      - uses: DeterminateSystems/nix-installer-action@main
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: wimpysworld/nothing-but-nix@b2574ec1cf1462bee0a34de0fb6ff11ad3c43cb2 # v12
+      - uses: cachix/install-nix-action@382a9ed9481c7c1f94f68b72ef105b3417c73877 # v32.1.0
         with:
-          extra-conf: |
+          extra_nix_config: |
+            # Substitute from the caches that the nixConfig of flake.nix names
+            accept-flake-config = true
             build-dir = /nix/build
-      - uses: cachix/cachix-action@master
+      - uses: cachix/cachix-action@38b082610b782e7e93e209c35fd730d399dee866 # v17
         with:
           name: yzhou216
           authToken: ${{ secrets.CACHIX_AUTH_TOKEN }}
       - name: Update flake.lock
-        run: nix flake update
+        if: env.UPDATE == 'true'
+        run: |
+          nix flake update 2>&1 | tee update.log
+          {
+            echo '```'
+            cat update.log
+            echo '```'
+          } >>"$GITHUB_STEP_SUMMARY"
 
       # Same target as `nixos-rebuild switch --flake . --impure`;
       # `--impure` is needed because the Emacs overlay uses a bare
       # `builtins.fetchTarball`.
       # `--keep-going` builds the rest if one package fails, and
       # cachix's daemon pushes each successful path as it builds.
+      # The step times out before the job does, which leaves cachix
+      # time to push the paths still queued.
       - name: Build galago
+        timeout-minutes: 330
         run: |
           nix build \
             --impure \
             --keep-going \
             --no-link \
