diff --git a/machines/openwrt/fritzbox-7412.nix b/machines/openwrt/fritzbox-7412.nix
new file mode 100644
index 0000000..9b02460
--- /dev/null
+++ b/machines/openwrt/fritzbox-7412.nix
@@ -0,0 +1,24 @@
+# OpenWrt Image Builder configuration of the AVM FRITZ!Box 7412
+{ pkgs, profiles }:
+profiles.identifyProfile "avm_fritz7412"
+// {
+  # Packages to include in the image instead of installing them later
+  packages = [ "tcpdump" ];
+
+  disabledServices = [ "dnsmasq" ];
+
+  /*
+    Files to include in the image.  UCI configuration is set with a
+    uci-defaults script, as the OpenWrt Image Builder documentation
+    recommends.
+  */
+  files = pkgs.runCommand "image-files" { } ''
+    mkdir -p $out/etc/uci-defaults
+    cat > $out/etc/uci-defaults/99-custom <<EOF
+    uci -q batch << EOI
+    set system.@system[0].hostname='testap'
+    commit
+    EOI
+    EOF
+  '';
+}
diff --git a/patched.nix b/patched.nix
new file mode 100644
index 0000000..9277533
--- /dev/null
+++ b/patched.nix
@@ -0,0 +1,114 @@
+/*
+  Flake inputs with commits from open pull requests applied on top.
+  Each commit is pinned so that pushes to a pull request do not
+  invalidate the hashes.
+
+  TODO: remove each pull request once it is merged, and this file once
+  none are left.
+*/
+{ nixpkgs, ... }:
+let
+  inherit (nixpkgs) lib;
+  pkgs = nixpkgs.legacyPackages.x86_64-linux;
+
+  /*
+    Fetch the patch of a commit of the GitHub pull request `pr` from
+    the commit URL in the repository of the pull request.  Attributes
+    of the commit other than `rev` are passed on to fetchpatch.
+  */
+  fetchPrCommit =
+    pr:
+    { rev, ... }@commit:
+    let
+      repo = lib.head (lib.splitString "/pull/" pr.url);
+    in
+    pkgs.fetchpatch ({ url = "${repo}/commit/${rev}.patch"; } // removeAttrs commit [ "rev" ]);
+
+  /*
+    Apply the commits of `pullRequests` on top of the source tree `src`.
+    Each pull request has its URL and its commits in the order they
+    apply, each with its revision and the hash of its patch.
+  */
+  applyPullRequests =
+    {
+      name,
+      src,
+      pullRequests,
+    }:
+    pkgs.applyPatches {
+      inherit name src;
+      patches = lib.concatMap (pr: map (fetchPrCommit pr) pr.commits) pullRequests;
+    };
+in
+rec {
+  /*
+    Nixpkgs master with the commits below applied.  Evaluating a
+    system from the patched tree imports from a derivation, so the
+    patched source is built before evaluation.
+
+    TODO: go back to `nixpkgs.lib.nixosSystem` once no pull requests
+    are left.
+  */
+  nixpkgs-patched = applyPullRequests {
+    name = "nixpkgs-patched";
+    src = nixpkgs;
+    pullRequests = [
+      {
+        url = "https://github.com/NixOS/nixpkgs/pull/550395";
+        commits = [
+          # nixos/river: init
+          {
+            rev = "e0158f7c4876e3a5785a8f6f9582220c72a2d3ca";
+            hash = "sha256-u51R02kTwqGfBAn30xt//qpSlkAxIJ06/1etKsNNpv4=";
+          }
+          # kwm: init at 0.3.0
+          {
+            rev = "c08b9ab09a451370fecb4c9fb066524f5c302b34";
+            hash = "sha256-jGFJ/ukFauntI2RRosyA3JVFQvhj5ARErDlYtIBEk9U=";
+          }
+          # nixos/kwm: init
+          {
+            rev = "95213484d31f167321bcf01af375f77c57fa538b";
+            hash = "sha256-WC4SVSAivKi8SX4L6dFsq0n5BAgnJjuPnAQrLwsrB6g=";
+          }
+          # kwim: init at 0.2.0
+          {
+            rev = "a6846d48060dd112964e2ee55935692f8838bf5e";
+            hash = "sha256-sfZC7jThRQhnaBwBw/dw2EQXUzP3YwKDS6tzV2YVC44=";
+          }
+        ];
+      }
+      {
+        url = "https://github.com/NixOS/nixpkgs/pull/566470";
+        commits = [
+          # maintainers: add jakob1379
+          {
+            rev = "094265f353ac97584592b65fdcade927cd628c4e";
+            hash = "sha256-Y+QRgmLs6ooXo0N0YGWhRVaHP5pqK6zf5bNMbi7k9Xg=";
+          }
+          # nixos/t3code: init
+          {
+            rev = "c73e1fccfdf1e52182d9693b645587e3f4c27310";
+            hash = "sha256-C8WLiZVYUaPYhH7bKRYriy0+FpT9MWYiCeAmDUKeSz0=";
+          }
+        ];
+      }
+    ];
+  };
+
+  # Same as `nixpkgs.lib.nixosSystem`, but from the patched tree
+  nixosSystem-patched =
+    args:
+    import "${nixpkgs-patched}/nixos/lib/eval-config.nix" (
+      {
+        lib = import "${nixpkgs-patched}/lib";
+        system = null;
+        # Errors in inline modules name the file of the caller, not this one
+        modulesLocation = (builtins.unsafeGetAttrPos "modules" args).file or null;
+      }
+      // args
+      // {
+        modules = args.modules ++ [ { config.nixpkgs.flake.source = nixpkgs-patched.outPath; } ];
+      }
+    );
+}
