+
+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        if: always() && env.UPDATE == 'true'
+        with:
+          name: flake.lock
+          path: flake.lock
diff --git a/.github/workflows/check.yml b/.github/workflows/check.yml
new file mode 100644
index 0000000..15885ab
--- /dev/null
+++ b/.github/workflows/check.yml
@@ -0,0 +1,42 @@
+# Runs `nix flake check` on each push and pull request, with the inputs
+# that flake.lock pins, except openwrt-imagebuilder, which it updates
+# first.  It evaluates every NixOS and nix-darwin configuration and
+# package, and checks the formatting, in a few minutes, without building
+# any system.
+name: check
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: cachix/install-nix-action@382a9ed9481c7c1f94f68b72ef105b3417c73877 # v32.1.0
+        with:
+          extra_nix_config: |
+            # Substitute from the caches that the nixConfig of flake.nix names
+            accept-flake-config = true
+
+      # The OpenWrt Image Builder pins the hashes of the package indexes
+      # of OpenWrt, which change whenever OpenWrt rebuilds packages, and
+      # updates them once a day, so packages.x86_64-linux.openwrt soon
+      # fails to evaluate with an older lock.  The update takes the newest
+      # Image Builder code and its own inputs as well, not only the
+      # hashes, so the check does not test that input as committed, and
+      # two runs of one commit can differ.  Building the image needs this
+      # update anyway; the run does not commit it.  The check can still
+      # fail on the OpenWrt package between a rebuild of OpenWrt and the
+      # next update of the Image Builder.
+      - name: Update the OpenWrt Image Builder
+        run: nix flake update openwrt-imagebuilder
+
+      # --impure lets the Emacs overlay, a bare builtins.fetchTarball in
+      # systems/nixos/commons.nix, evaluate.  --all-systems evaluates the
+      # checks of aarch64-darwin, which are the nix-darwin configurations.
+      - name: Check the flake
+        run: nix flake check --impure --all-systems --keep-going
diff --git a/flake.nix b/flake.nix
index e74cecb..ba49ed1 100644
--- a/flake.nix
+++ b/flake.nix
@@ -273,5 +273,37 @@
           ];
         };
       };
+
+      # nix fmt
+      formatter = nixpkgs.lib.genAttrs [
+        "x86_64-linux"
+        "aarch64-darwin"
+      ] (system: nixpkgs.legacyPackages.${system}.nixfmt-tree);
+
+      /*
+        `nix flake check` builds these checks, in addition to evaluating
+        the NixOS configurations and the packages, which it does on its
+        own.
+      */
+      checks = {
+        # Fails on each Nix file that `nix fmt` would change
+        x86_64-linux.nixfmt =
+          let
+            pkgs = nixpkgs.legacyPackages.x86_64-linux;
+          in
+          pkgs.runCommand "nixfmt-check" { nativeBuildInputs = [ pkgs.nixfmt ]; } ''
+            cd ${self}
+            find . -name '*.nix' -exec nixfmt --check {} +
+            touch $out
+          '';
+
+        /*
+          Each nix-darwin configuration is a check too, since
+          `nix flake check` ignores `darwinConfigurations`.  It builds
+          them on aarch64-darwin, and evaluates them on other
+          platforms with `--all-systems`.
+        */
+        aarch64-darwin = builtins.mapAttrs (_: host: host.system) self.darwinConfigurations;
+      };
     };
 }
