diff --git a/.github/workflows/check.yml b/.github/workflows/check.yml
new file mode 100644
index 0000000..930ac56
--- /dev/null
+++ b/.github/workflows/check.yml
@@ -0,0 +1,41 @@
+# Runs `nix flake check` on each push and pull request, with the inputs
+# that flake.lock pins, except openwrt-imagebuilder, which it updates
+# first.  It evaluates every NixOS and nix-darwin configuration and
+# package, and checks the formatting, in a few minutes, without building
+# any system.
+name: check
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: cachix/install-nix-action@382a9ed9481c7c1f94f68b72ef105b3417c73877 # v32.1.0
+        with:
+          extra_nix_config: |
+            # Substitute from the caches that the nixConfig of flake.nix names
+            accept-flake-config = true
+
+      # The OpenWrt Image Builder pins the hashes of the package indexes
+      # of OpenWrt, which change whenever OpenWrt rebuilds packages, and
+      # updates them once a day, so packages.x86_64-linux.openwrt soon
+      # fails to evaluate with an older lock.  The update takes the newest
+      # Image Builder code and its own inputs as well, not only the
+      # hashes, so the check does not test that input as committed, and
+      # two runs of one commit can differ.  Building the image needs this
+      # update anyway; the run does not commit it.  The check can still
+      # fail on the OpenWrt package between a rebuild of OpenWrt and the
+      # next update of the Image Builder.
+      - name: Update the OpenWrt Image Builder
+        run: nix flake update openwrt-imagebuilder
+
+      # --all-systems evaluates the checks of aarch64-darwin, which are
+      # the nix-darwin configurations.
+      - name: Check the flake
+        run: nix flake check --all-systems --keep-going
diff --git a/disko/bcachefs-image-builder.nix b/disko/bcachefs-image-builder.nix
new file mode 100644
index 0000000..42fdad1
--- /dev/null
+++ b/disko/bcachefs-image-builder.nix
@@ -0,0 +1,30 @@
+{ pkgs, lib, ... }:
+{
+  /*
+    The disko image-builder VM builds its initrd from in-tree kernel
+    modules only, but nixpkgs ships bcachefs as an out-of-tree module
+    (pkgs.linuxPackages.bcachefs).  Merge it into the kernel module
+    tree and regenerate modules.dep so the builder's initrd can find
+    it.
+  */
+  disko.imageBuilder = {
+    extraRootModules = [ "bcachefs" ];
+    kernelPackages = pkgs.linuxPackages // {
+      kernel = pkgs.linuxPackages.kernel // {
+        modules = pkgs.buildEnv {
+          name = "kernel-modules-with-bcachefs";
+          paths = with pkgs.linuxPackages; [
+            kernel.modules
+            bcachefs
+          ];
+
+          postBuild = ''
+            version=$(cd $out/lib/modules && ls -d *)
+            ${lib.getExe' pkgs.kmod "depmod"} \
+              --basedir "$out" --all "$version"
+          '';
+        };
+      };
+    };
+  };
+}
