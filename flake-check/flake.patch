index 0000000..031cbcc
--- /dev/null
+++ b/patched.nix
@@ -0,0 +1,71 @@
+{ nixpkgs, ... }:
+rec {
+  /*
+    Nixpkgs master with commits from open pull requests applied on
+    top.  Each commit is pinned so that pushes to a pull request do
+    not invalidate the hashes.  Evaluating a system from the
+    patched tree imports from a derivation, so the patched source
+    is built before evaluation.
+
+    TODO: remove the patches of each pull request once it is
+    merged, and go back to `nixpkgs.lib.nixosSystem` once none are
+    left.
+  */
+  nixpkgs-patched =
+    let
+      pkgs = nixpkgs.legacyPackages.x86_64-linux;
+      fetchPrCommit =
+        pr: rev: hash:
+        pkgs.fetchpatch {
+          url = "https://github.com/NixOS/nixpkgs/commit/${rev}.patch";
+          inherit hash;
+        };
+    in
+    pkgs.applyPatches {
+      name = "nixpkgs-patched";
+      src = nixpkgs;
+      patches = [
+        # https://github.com/NixOS/nixpkgs/pull/550395
+        # nixos/river: init
+        (fetchPrCommit 550395 "e0158f7c4876e3a5785a8f6f9582220c72a2d3ca"
+          "sha256-u51R02kTwqGfBAn30xt//qpSlkAxIJ06/1etKsNNpv4="
+        )
+        # kwm: init at 0.3.0
+        (fetchPrCommit 550395 "c08b9ab09a451370fecb4c9fb066524f5c302b34"
+          "sha256-jGFJ/ukFauntI2RRosyA3JVFQvhj5ARErDlYtIBEk9U="
+        )
+        # nixos/kwm: init
+        (fetchPrCommit 550395 "95213484d31f167321bcf01af375f77c57fa538b"
+          "sha256-WC4SVSAivKi8SX4L6dFsq0n5BAgnJjuPnAQrLwsrB6g="
+        )
+        # kwim: init at 0.2.0
+        (fetchPrCommit 550395 "a6846d48060dd112964e2ee55935692f8838bf5e"
+          "sha256-sfZC7jThRQhnaBwBw/dw2EQXUzP3YwKDS6tzV2YVC44="
+        )
+
+        # https://github.com/NixOS/nixpkgs/pull/566470
+        # maintainers: add jakob1379
+        (fetchPrCommit 566470 "094265f353ac97584592b65fdcade927cd628c4e"
+          "sha256-Y+QRgmLs6ooXo0N0YGWhRVaHP5pqK6zf5bNMbi7k9Xg="
+        )
+        # nixos/t3code: init
+        (fetchPrCommit 566470 "c73e1fccfdf1e52182d9693b645587e3f4c27310"
+          "sha256-C8WLiZVYUaPYhH7bKRYriy0+FpT9MWYiCeAmDUKeSz0="
+        )
+      ];
+    };
+
+  # Same as `nixpkgs.lib.nixosSystem`, but from the patched tree
+  nixosSystem-patched =
+    args:
+    import "${nixpkgs-patched}/nixos/lib/eval-config.nix" (
+      {
+        lib = import "${nixpkgs-patched}/lib";
+        system = null;
+      }
+      // args
+      // {
+        modules = args.modules ++ [ { config.nixpkgs.flake.source = nixpkgs-patched.outPath; } ];
+      }
+    );
+}
