diff --git a/systems/nixos/emacs.nix b/systems/nixos/emacs.nix
new file mode 100644
index 0000000..704f06d
--- /dev/null
+++ b/systems/nixos/emacs.nix
@@ -0,0 +1,29 @@
+{
+  nixpkgs.overlays = [
+    (import (
+      builtins.fetchTarball {
+        url = "https://github.com/nix-community/emacs-overlay/archive/master.tar.gz";
+      }
+    ))
+
+    (final: prev: {
+      emacs-git = prev.emacs-git.overrideAttrs (
+        _: prevAttrs: {
+          src = builtins.fetchGit {
+            url = "https://github.com/emacsmirror/emacs.git";
+            ref = "master";
+          };
+
+          # Keep RET from being refilled away by `refill-mode' in Org
+          patches = (prevAttrs.patches or [ ]) ++ [ ./emacs-refill-newline.patch ];
+        }
+      );
+
+      emacs-unstable = prev.emacs-unstable.overrideAttrs (
+        _: _: {
+          src = final.emacs-git.src;
+        }
+      );
+    })
+  ];
+}
diff --git a/systems/nixos/network.nix b/systems/nixos/network.nix
new file mode 100644
index 0000000..33959a0
--- /dev/null
+++ b/systems/nixos/network.nix
@@ -0,0 +1,30 @@
+{
+  networking = {
+    wireless.iwd = {
+      enable = true;
+      settings = {
+        General.AddressRandomization = "once";
+        IPv6.Enabled = true;
+        Settings.AutoConnect = true;
+      };
+    };
+
+    # Use nftables as the backend instead of iptables
+    nftables.enable = true;
+  };
+
+  services = {
+    # OpenSSH daemon
+    openssh.enable = true;
+
+    tailscale = {
+      enable = true;
+      useRoutingFeatures = "both";
+      extraSetFlags = [
+        "--exit-node-allow-lan-access=true"
+        "--operator=yiyu"
+        "--ssh"
+      ];
+    };
+  };
+}
diff --git a/systems/nixos/t3code.nix b/systems/nixos/t3code.nix
new file mode 100644
index 0000000..e0b4fad
--- /dev/null
+++ b/systems/nixos/t3code.nix
@@ -0,0 +1,23 @@
+{
+  imports = [ ./t3code-themes.nix ];
+
+  # Web GUI for LLM programming agents, reachable over the network
+  services.t3code = {
+    enable = true;
+    user = "yiyu";
+    host = "0.0.0.0";
+    openFirewall = true;
+  };
+
+  systemd.services.t3code.environment = {
+    # Passphrase-less SSH key for t3code, which fetches at boot before login
+    # and so must not prompt through gpg-agent while the GNOME keyring is locked
+    GIT_SSH_COMMAND = "ssh -i /home/yiyu/.ssh/id_ed25519_t3code -o IdentitiesOnly=yes -o IdentityAgent=none";
+
+    # Unattended retry mode of Claude Code, in which t3code sessions wait out a
+    # usage limit until it resets instead of failing the turn
+    CLAUDE_CODE_RETRY_WATCHDOG = "1";
+    # Cover the 5-hour window, but keep a weekly limit from stalling for days
+    CLAUDE_CODE_RETRY_WATCHDOG_MAX_WAIT_MS = toString (6 * 60 * 60 * 1000);
+  };
+}
