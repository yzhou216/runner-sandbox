diff --git a/machines/darwin/lexi.nix b/machines/darwin/lexi.nix
index 872bbaf..f70c18c 100644
--- a/machines/darwin/lexi.nix
+++ b/machines/darwin/lexi.nix
@@ -1,6 +1,11 @@
 { ... }:
 {
-  ids.gids.nixbld = 350; # temp
+  /*
+    The Nix installer of this machine created the nixbld group with GID
+    350, while nix-darwin expects 30000 at state version 4 and refuses
+    to activate when they differ.
+  */
+  ids.gids.nixbld = 350;
 
