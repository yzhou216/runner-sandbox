From 2cf31515049fb6cb37348888efebd15b35adb1b0 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Fri, 27 Nov 2026 15:22:06 -0800
Subject: [PATCH] lib/types/bcachefs_filesystem: detect unlocked single-device
 filesystems

Mounting a second subvolume of an encrypted filesystem runs `bcachefs
unlock` again, which fails with EBUSY on the open device.  disko then
takes /sys/fs/bcachefs/<uuid> as proof that the filesystem is unlocked,
as of 4031864 ("lib/types/bcachefs_filesystem: tolerate
already-unlocked filesystem").  bcachefs names that directory after the
UUID only for a multi-device filesystem, though, and after its device
otherwise, so mounting a single-device encrypted filesystem with more
than one mounted subvolume fails:

  bcachefs (/dev/disk/by-uuid/...): error reading superblock: Device or resource busy
    requested read-write, exclusive
    device is in use: already mounted, or held by another process

Also accept a mount of the filesystem as proof that it is unlocked, and
add such a filesystem to the bcachefs example and test.

Assisted-by: T3 Code
---
 example/bcachefs.nix              | 34 +++++++++++++++++++++++++++++++
 lib/types/bcachefs_filesystem.nix | 12 ++++++++---
 tests/bcachefs.nix                |  9 +++++++-
 3 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/example/bcachefs.nix b/example/bcachefs.nix
index 023822b..3a8ae66 100644
--- a/example/bcachefs.nix
+++ b/example/bcachefs.nix
@@ -93,6 +93,24 @@
           };
         };
       };
+
+      vdf = {
+        device = "/dev/vdf";
+        type = "disk";
+        content = {
+          type = "gpt";
+          partitions = {
+            vdf1 = {
+              size = "100%";
+              content = {
+                type = "bcachefs";
+                filesystem = "encrypted_single_device";
+                label = "group_a.vdf1";
+              };
+            };
+          };
+        };
+      };
     };
 
     bcachefs_filesystems = {
@@ -137,6 +155,22 @@
         mountpoint = "/home/Documents";
         uuid = "64e50034-ebe2-eaf8-1f93-cf56266a8d86";
       };
+
+      # Example showing an encrypted single-disk filesystem with more
+      # than one mounted subvolume.
+      encrypted_single_device = {
+        type = "bcachefs_filesystem";
+        passwordFile = "/tmp/secret.key";
+        subvolumes = {
+          "subvolumes/srv" = {
+            mountpoint = "/srv";
+          };
+          # Mounted beneath the subvolume above, so after it at boot.
+          "subvolumes/data" = {
+            mountpoint = "/srv/data";
+          };
+        };
+      };
     };
   };
 }
diff --git a/lib/types/bcachefs_filesystem.nix b/lib/types/bcachefs_filesystem.nix
index 59c17a4..d561e14 100644
--- a/lib/types/bcachefs_filesystem.nix
+++ b/lib/types/bcachefs_filesystem.nix
@@ -193,7 +193,9 @@
                 MNTPOINT="$(mktemp -d)";
                 ${lib.optionalString (config.passwordFile != null) ''
                   if ! bcachefs unlock -k session "/dev/disk/by-uuid/${config.uuid}" < "${config.passwordFile}"; then
-                    test -d "/sys/fs/bcachefs/${config.uuid}";
+                    # Mounted already, so unlocked.  sysfs names a single-device
+                    # filesystem after its device rather than its UUID.
+                    test -d "/sys/fs/bcachefs/${config.uuid}" || findmnt --source "UUID=${config.uuid}" >&2;
                   fi;
                 ''}
                 mount \
@@ -232,7 +234,9 @@
                   mkdir -p "${globals.rootMountPoint}${subvolume.mountpoint}";
                   ${lib.optionalString (config.passwordFile != null) ''
                     if ! bcachefs unlock -k session "/dev/disk/by-uuid/${config.uuid}" < "${config.passwordFile}"; then
-                      test -d "/sys/fs/bcachefs/${config.uuid}";
+                      # Mounted already, so unlocked.  sysfs names a single-device
+                      # filesystem after its device rather than its UUID.
+                      test -d "/sys/fs/bcachefs/${config.uuid}" || findmnt --source "UUID=${config.uuid}" >&2;
                     fi;
                   ''}
                   mount \
@@ -266,7 +270,9 @@
                   mkdir -p "${globals.rootMountPoint}${config.mountpoint}";
                   ${lib.optionalString (config.passwordFile != null) ''
                     if ! bcachefs unlock -k session "/dev/disk/by-uuid/${config.uuid}" < "${config.passwordFile}"; then
-                      test -d "/sys/fs/bcachefs/${config.uuid}";
+                      # Mounted already, so unlocked.  sysfs names a single-device
+                      # filesystem after its device rather than its UUID.
+                      test -d "/sys/fs/bcachefs/${config.uuid}" || findmnt --source "UUID=${config.uuid}" >&2;
                     fi;
                   ''}
                   mount \
diff --git a/tests/bcachefs.nix b/tests/bcachefs.nix
index b671551..78d472a 100644
--- a/tests/bcachefs.nix
+++ b/tests/bcachefs.nix
@@ -38,7 +38,8 @@ diskoLib.testLib.makeDiskoTest {
 
     # bcachefs-tools >= 1.33.1 cannot read the superblock from a mounted device 
     def bcachefs_sysfs(mp):
-        src = machine.succeed(f"findmnt -no SOURCE {mp}").strip().split(":")[0]
+        # --nofsroot leaves out the [/subvolume] of a subvolume mount
+        src = machine.succeed(f"findmnt --nofsroot -no SOURCE {mp}").strip().split(":")[0]
         dev = src.rsplit("/", 1)[-1]
         path = machine.succeed(
             "for d in /sys/fs/bcachefs/*/dev-*/block; do "
@@ -55,16 +56,22 @@ diskoLib.testLib.makeDiskoTest {
     machine.succeed("mountpoint /home");
     machine.succeed("mountpoint /nix");
     machine.succeed("mountpoint /home/Documents");
+    machine.succeed("mountpoint /srv");
+    machine.succeed("mountpoint /srv/data");
     machine.fail("mountpoint /non-existent");
 
     multi_sysfs = bcachefs_sysfs("/")
     single_sysfs = bcachefs_sysfs("/home/Documents")
+    encrypted_single_sysfs = bcachefs_sysfs("/srv")
 
     # Verify device membership.
     multi_devs = int(machine.succeed(f"ls -d {multi_sysfs}/dev-* | wc -l").strip())
     assert multi_devs == 3, f"Expected 3 devices in {multi_sysfs}, got {multi_devs}"
     single_devs = int(machine.succeed(f"ls -d {single_sysfs}/dev-* | wc -l").strip())
     assert single_devs == 1, f"Expected 1 device in {single_sysfs}, got {single_devs}"
+    encrypted_single_devs = int(machine.succeed(f"ls -d {encrypted_single_sysfs}/dev-* | wc -l").strip())
+    assert encrypted_single_devs == 1, f"Expected 1 device in {encrypted_single_sysfs}, got {encrypted_single_devs}"
+    assert encrypted_single_sysfs == bcachefs_sysfs("/srv/data"), "Expected /srv and /srv/data on one filesystem"
 
     # Verify labels.
     multi_labels = set(machine.succeed(f"cat {multi_sysfs}/dev-*/label").split())
-- 
2.56.1

