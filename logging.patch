+
+/// Seconds since the epoch, for the log of this check
+pub(super) fn stamp() -> String {
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap_or_default();
+    format!("{}.{:03}", now.as_secs(), now.subsec_millis())
+}
+
+/// Logs every keyboard event as iced hands it over, captured by a widget or
+/// not
+pub(super) fn log_raw(
+    event: iced::Event,
+    status: iced::event::Status,
+    _window: iced::window::Id,
+) -> Option<Message> {
+    if let iced::Event::Keyboard(keyboard::Event::KeyPressed {
+        key,
+        modified_key,
+        physical_key,
+        modifiers,
+        text,
+        repeat,
+        ..
+    }) = &event
+    {
+        eprintln!(
+            "[{}] RAW key={key:?} modified_key={modified_key:?} physical={physical_key:?} modifiers={modifiers:?} text={text:?} repeat={repeat} status={status:?}",
+            stamp()
+        );
+    }
+    None
 }
