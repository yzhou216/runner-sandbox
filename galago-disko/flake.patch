diff --git c/disko/bcachefs-encrypted.nix w/disko/bcachefs-encrypted.nix
new file mode 100644
index 0000000..d84259e
--- /dev/null
+++ w/disko/bcachefs-encrypted.nix
@@ -0,0 +1,42 @@
+/*
+  The layout of bcachefs.nix with the filesystem encrypted by bcachefs
+  and unlocked in the initrd.  Swap is encrypted by dm-crypt instead,
+  since bcachefs cannot hold swap.
+*/
+{ lib, ... }:
+{
+  imports = [ ./bcachefs.nix ];
+
+  disko.devices = {
+    disk.disk1.content.partitions.plainSwap.content = {
+      /*
+        A new random key at every boot rules out hibernation.  To
+        hibernate, put swap on LUKS instead.
+      */
+      randomEncryption = true;
+      resumeDevice = lib.mkForce false;
+    };
+
+    # Passphrase from `nixos-anywhere --disk-encryption-keys /tmp/secret.key <file>`
+    bcachefs_filesystems.mounted_subvolumes.passwordFile = "/tmp/secret.key";
+  };
+
+  # Hibernating would save the session to swap that the next boot cannot read
+  systemd.sleep.settings.Sleep = {
+    AllowHibernation = false;
+    AllowHybridSleep = false;
+    AllowSuspendThenHibernate = false;
+  };
+
+  /*
+    NixOS asks for the passphrase once for each bcachefs mount in the
+    initrd, since `bcachefs unlock --check` succeeds whether or not the
+    key is loaded.  /, /nix, and /home are one filesystem, so unlock it
+    for / alone; systemd mounts the other two after /sysroot, beneath
+    it.
+  */
+  boot.initrd.systemd.services = {
+    unlock-bcachefs-nix.requiredBy = lib.mkForce [ ];
+    unlock-bcachefs-home.requiredBy = lib.mkForce [ ];
+  };
+}
