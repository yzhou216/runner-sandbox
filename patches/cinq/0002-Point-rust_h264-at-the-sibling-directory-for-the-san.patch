From df0c26fb2011442eec51bf4ce21736f4a2a9b8e5 Mon Sep 17 00:00:00 2001
From: Yiyu Zhou <yiyu@yiyuzhou.io>
Date: Mon, 9 Nov 2026 12:52:15 -0800
Subject: [PATCH 2/2] Point rust_h264 at the sibling directory for the sandbox

---
 Cargo.lock | 2 --
 Cargo.toml | 3 +++
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index bd10d65..58ed185 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -3349,8 +3349,6 @@ checksum = "5974e397833d890f2f74963408e0d4a6cd8eda2f6a445ae06750291b5d7a997e"
 [[package]]
 name = "rust_h264"
 version = "0.6.1"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "49a852e1544c48fba7d072620420c602f195092e3774655584ef5e4e6fd056a9"
 
 [[package]]
 name = "rustc-hash"
diff --git a/Cargo.toml b/Cargo.toml
index 87c7251..c1c6c1c 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -106,3 +106,6 @@ resvg = { version = "0.49", default-features = false }
 
 [profile.dev.package."*"]
 opt-level = 3
+
+[patch.crates-io]
+rust_h264 = { path = "../rust_h264" }
