+/// Threads that decode and convert pictures: one for each core, up to
+/// eight, enough to spread a picture over the cores of most machines.  The
+/// cores are counted once, since std counts them anew at each call, too
+/// slowly for every picture.
+static THREADS: LazyLock<usize> = LazyLock::new(|| {
+    thread::available_parallelism()
+        .map_or(1, NonZero::get)
+        .min(8)
+});
+
+/// Pictures that the decoder holds back to put in order when the stream
+/// does not say how many it reorders, which is the decoder's own default,
+/// and the most that it holds back for any stream, which is as many as
+/// H.264 allows
+const REORDER: usize = 16;
+
